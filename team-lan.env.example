# 团队内部局域网自用环境模板（复制为 .env.production 或 .env.team-lan 并在仓库外管理，切勿提交真实密钥）
# 启动命令：
#   docker compose -p globalcrm --env-file .env.production -f compose.yaml -f compose.lan.yaml up -d --build
APP_ENV=production
# self_hosted = 团队自用模式（隐藏商业账单/平台管理入口、关闭套餐超额拦截、保留用量统计、支持白名单内网 AI 网关）
CRM_EDITION=self_hosted
ENFORCE_PLAN_LIMITS=false

# 允许接入的本地/局域网 AI 网关精确 Origin 白名单（逗号分隔，仅填协议+主机+端口，如宿主机 workbuddy2api）
AI_ALLOWED_INTERNAL_ORIGINS=http://host.docker.internal:7863

# 局域网访问端口与网卡（默认 0.0.0.0:5173，同事访问 http://<宿主机局域网IP>:5173）
GLOBALCRM_BIND_HOST=0.0.0.0
GLOBALCRM_HTTP_PORT=5173
# 局域网纯 HTTP 访问时必须设为 false，否则浏览器会拒收登录 Cookie；如后续加了内网 HTTPS 反代请改回 true
COOKIE_SECURE=false
CORS_ALLOW_PRIVATE_NETWORK=true
CORS_LAN_PORTS=5173,8080
# 将下面 IP 替换为宿主机实际局域网 IP（用于密码重置链接等内部跳转）
APP_BASE_URL=http://192.168.1.100:5173
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.100:5173
# 若无公网域名，保持内网/本机地址即可：自用模式会自动跳过外发开发信的追踪链接改写，不向客户暴露内网 IP（签名 Logo 走内联附件不受影响）
TRACKING_BASE_URL=http://localhost:5173
PUBLIC_BASE_URL=http://localhost:5173

MONGO_ROOT_USERNAME=REPLACE_WITH_PRIVATE_MONGO_ADMIN_USER
MONGO_ROOT_PASSWORD=REPLACE_WITH_PRIVATE_MONGO_ADMIN_PASSWORD
MONGODB_URI=mongodb://REPLACE_WITH_URI_ENCODED_MONGO_USER:REPLACE_WITH_URI_ENCODED_MONGO_PASSWORD@mongo:27017/cdlm?authSource=admin&replicaSet=rs0
JWT_SECRET=REPLACE_WITH_UNIQUE_RANDOM_32_PLUS_CHARACTER_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_DAYS=30
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_WITH_UNIQUE_RANDOM_16_PLUS_CHARACTER_PASSWORD
ADMIN_EMAIL=
MAIL_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_ANOTHER_RANDOM_32_PLUS_CHARACTER_SECRET

VITE_API_BASE_URL=/api
VITE_APP_TITLE=GlobalCRM
MAIL_TRANSPORT=smtp
SMTP_HOST=REPLACE_WITH_SMTP_HOST
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=REPLACE_WITH_SMTP_USER
SMTP_PASS=REPLACE_WITH_SMTP_PASSWORD
SMTP_REQUIRE_TLS=true
IMAP_ENABLED=false

DEFAULT_ORGANIZATION_NAME=Default Organization
DEFAULT_ORGANIZATION_SLUG=default
RUN_BACKGROUND_JOBS=false
WORKER_HEALTH_PORT=5100
STORAGE_PROVIDER=local
METRICS_ENABLED=true
AI_REQUEST_TIMEOUT_MS=110000
AI_MAX_OUTPUT_TOKENS=8192
AI_DAILY_RUN_LIMIT=1000
AI_DAILY_TOKEN_LIMIT=5000000
LAN_AI_MAX_OUTPUT_TOKENS=8192
LAN_AI_DAILY_RUN_LIMIT=1000
LAN_AI_DAILY_TOKEN_LIMIT=5000000
API_RATE_LIMIT_WINDOW_MS=60000
API_RATE_LIMIT_MAX=600
OIDC_ENABLED=false
OIDC_ALLOW_LOOPBACK=false
